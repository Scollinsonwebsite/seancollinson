# Mediation Office of S. Collinson: Apache configuration for Bluehost
# Generated by build.mjs on 2026-10-09. Edit src/config.mjs and rebuild rather than editing here.
# Safe for a shared public_html: rules below apply only to seancollinson.com.

Options -Indexes
AddDefaultCharset utf-8
AddType image/svg+xml .svg
AddType font/woff2 .woff2
AddType application/manifest+json .webmanifest

<If "%{HTTP_HOST} =~ m#^(www\.)?seancollinson\.com$#i">
  DirectoryIndex index.html index.php
  ErrorDocument 404 /404.html
  # Never serve hidden files (except .well-known).
  RedirectMatch 404 /\.(?!well-known/)
</If>

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Force HTTPS and the canonical host (seancollinson.com) for this site only.
  RewriteCond %{HTTP_HOST} ^(www\.)?seancollinson\.com$ [NC]
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} !^seancollinson\.com$ [NC]
  RewriteRule ^ https://seancollinson.com%{REQUEST_URI} [L,R=301]

  # Old WordPress addresses → new pages (permanent).
  RewriteCond %{HTTP_HOST} ^(www\.)?seancollinson\.com$ [NC]
  RewriteRule ^contact-us/?$ /contact/ [R=301,L]
  RewriteCond %{HTTP_HOST} ^(www\.)?seancollinson\.com$ [NC]
  RewriteRule ^(home|hello-world)/?$ / [R=301,L]

  # Remove index.html from URLs: /about/index.html → /about/
  RewriteCond %{HTTP_HOST} ^(www\.)?seancollinson\.com$ [NC]
  RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
  RewriteRule ^(.*/)?index\.html$ /$1 [R=301,L]

  # Block source and config files.
  RewriteCond %{HTTP_HOST} ^(www\.)?seancollinson\.com$ [NC]
  RewriteRule \.(md|mjs|lock|log|sh|ini|env|bak|sql)$ - [F,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff" "expr=%{HTTP_HOST} =~ m#^(www\.)?seancollinson\.com$#i"
  Header always set Referrer-Policy "strict-origin-when-cross-origin" "expr=%{HTTP_HOST} =~ m#^(www\.)?seancollinson\.com$#i"
  Header always set X-Frame-Options "SAMEORIGIN" "expr=%{HTTP_HOST} =~ m#^(www\.)?seancollinson\.com$#i"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()" "expr=%{HTTP_HOST} =~ m#^(www\.)?seancollinson\.com$#i"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://i.ytimg.com https://i.vimeocdn.com; font-src 'self'; connect-src 'self'; frame-src https://www.youtube-nocookie.com https://player.vimeo.com; form-action 'self'; base-uri 'self'; frame-ancestors 'self'; object-src 'none'" "expr=%{HTTP_HOST} =~ m#^(www\.)?seancollinson\.com$#i && %{REQUEST_URI} !~ m#^/wp-#"
  Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTP_HOST} =~ m#^(www\.)?seancollinson\.com$#i"
  Header set Cache-Control "no-cache" "expr=%{HTTP_HOST} =~ m#^(www\.)?seancollinson\.com$#i && %{REQUEST_URI} =~ m#(/|\.html)$#"
  Header set Cache-Control "public, max-age=31536000, immutable" "expr=%{HTTP_HOST} =~ m#^(www\.)?seancollinson\.com$#i && %{REQUEST_URI} =~ m#\.(css|js|woff2|svg|png|jpg|jpeg|webp|ico)$#"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/javascript application/json application/xml application/manifest+json image/svg+xml
</IfModule>

# php -- BEGIN cPanel-generated handler, do not edit
# Kept from the existing file: the other sites in this folder depend on it.
# Set the “ea-php83” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php83___lsphp .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
